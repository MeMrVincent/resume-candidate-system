{
  "name": "recruitment-system-v2-electron",
  "version": "2.0.0",
  "description": "Recruitment Management CRM / ATS V2 - Electron Main Process",
  "main": "main.js",
  "author": "Vincent",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:renderer": "npm --prefix ../frontend run build",
    "dist": "npm run build:renderer && electron-builder",
    "dist:dir": "npm run build:renderer && electron-builder --dir",
    "test:electron": "electron test/electron-native-smoke.js",
    "test": "node --test test/*.test.js",
    "import:candidates": "node src/import_runner.js",
    "report:import-warnings": "node src/report_import_warnings.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.recruitment.system.v2",
    "productName": "RecruitmentSystemV2",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../data/recruitment.db",
        "to": "seed/recruitment.db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
